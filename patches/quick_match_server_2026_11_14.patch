+    def remove_from_quick_queue(self, ws: Any) -> bool:
+        """Remove all stale entries, including during disconnect/cancel."""
+        if ws not in self.quick_queue:
+            return False
+        self.quick_queue = deque(peer for peer in self.quick_queue if peer is not ws)
+        return True
+
+    async def quick_match(self, ws: Any) -> None:
+        """FIFO matchmaking against another connected authenticated user.
+
+        A quick match uses the same authoritative Game object as code rooms.
+        The server starts it immediately; no ready buttons or manual codes.
+        """
+        if ws not in self.sessions:
+            await self.error(ws, "Сначала подключи игровой профиль.")
+            return
+        if ws in self.users:
+            await self.error(ws, "Сначала покинь текущую комнату.")
+            return
+        if ws in self.quick_queue:
+            await self.send(ws, {"type": "matchmaking", "status": "waiting"})
+            return
+        self.prune_rooms()
+        if len(self.rooms) >= MAX_ROOMS:
+            await self.error(ws, "Все игровые комнаты заняты. Попробуй позднее.")
+            return
+        opponent = None
+        # Preserve other users' place if they are incompatible, for example
+        # because either player has blocked the other.
+        for _ in range(len(self.quick_queue)):
+            peer = self.quick_queue.popleft()
+            if peer is ws or peer not in self.connected or peer not in self.sessions or peer in self.users:
+                continue
+            peer_id = self.sessions[peer]
+            my_id = self.sessions[ws]
+            if self.social.blocked(peer_id, my_id) or self.social.blocked(my_id, peer_id):
+                self.quick_queue.append(peer)
+                continue
+            opponent = peer
+            break
+        if opponent is None:
+            self.quick_queue.append(ws)
+            await self.send(ws, {"type": "matchmaking", "status": "waiting"})
+            return
+        while True:
+            code = f"{secrets.randbelow(900000) + 100000:06d}"
+            if code not in self.rooms:
+                break
+        names = [self.social.name_of(self.sessions[opponent]), self.social.name_of(self.sessions[ws])]
+        room = Room(code=code, clients=[opponent, ws], names=names,
+                    ready={0, 1}, mode="quick")
+        room.game = Game(names)
+        self.rooms[code] = room
+        self.users[opponent] = (code, 0)
+        self.users[ws] = (code, 1)
+        await self.announce_room(room)
+        await self.broadcast_state(room)
 
